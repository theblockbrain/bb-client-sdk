{
  "name": "@theblockbrain/bb-client-sdk",
  "version": "0.18.0",
  "description": "Shared frontend SDK for BlockBrain apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./agentic": {
      "types": "./dist/api/agentic/index.d.ts",
      "import": "./dist/api/agentic/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/office": {
      "types": "./dist/adapters/office.d.ts",
      "import": "./dist/adapters/office.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    },
    "./analytics/mixpanel": {
      "types": "./dist/analytics/mixpanel.d.ts",
      "import": "./dist/analytics/mixpanel.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    },
    "./telemetry/cookiebot": {
      "types": "./dist/telemetry/cookiebot.d.ts",
      "import": "./dist/telemetry/cookiebot.js"
    },
    "./ui/theme-base.css": "./dist/ui/theme-base.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "marked": "^14.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/ui/theme-base.css dist/ui/theme-base.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "lint": "biome check . && eslint src",
    "lint:biome": "biome check .",
    "lint:types": "eslint src",
    "lint:fix": "biome check --write .",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ui/theme-base.css",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "check:cleanroom": "node scripts/clean-room-check.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "lefthook": "^2.1.10",
    "publint": "0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
