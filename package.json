{
  "name": "@theblockbrain/bb-client-sdk",
  "version": "0.17.0",
  "description": "Shared frontend SDK for BlockBrain apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./settings": {
      "import": "./dist/settings/index.js",
      "types": "./dist/settings/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./prompt": {
      "import": "./dist/prompt/index.js",
      "types": "./dist/prompt/index.d.ts"
    },
    "./actions": {
      "import": "./dist/actions/index.js",
      "types": "./dist/actions/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui/index.js",
      "types": "./dist/ui/index.d.ts"
    },
    "./ui/theme-base.css": "./dist/ui/theme-base.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "marked": "^14.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/ui/theme-base.css dist/ui/theme-base.css",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check . && eslint src",
    "lint:biome": "biome check .",
    "lint:types": "eslint src",
    "lint:fix": "biome check --write .",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "tsup": "^8.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17"
  }
}
